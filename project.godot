; Robo Rush — Godot 4 project configuration.
;
; Logical resolution is a fixed 480x270 (see spec section 2). "viewport" stretch
; mode renders the whole game into that buffer and scales it up, so every pixel
; stays square and chunky; "keep" letterboxes rather than distorting the aspect.
; Input actions are generated by tools/generate_input_map.gd — edit that script
; and re-run it rather than hand-editing the [input] section below.

config_version=5

[application]

config/name="Robo Rush"
; The title screen, not the game. main.tscn is still directly launchable — the tests and
; `--seed=` debugging both do it — and starts a run immediately when it is.
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[gui]

; One default theme for every Control in the game (data/ui/theme.tres). The font is a
; hand-drawn 5x8 bitmap face: the game renders at 480x270 and is magnified whole, and a
; vector face antialiases at that size into a blur the magnifier only makes worse.
theme/custom="res://data/ui/theme.tres"


; A difficulty above the node it extends, and beside it: what this tier costs the player is a kill
; order, and an order only exists in a room with other things to kill in it. Weighted below the
; plain node, because a room with two of these is a room where every death spins both of them up.
weight = 1.0
min_difficulty = 3

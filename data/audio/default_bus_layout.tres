; The game's audio buses, as a file rather than as three AudioServer calls at startup.
;
; AudioManager can create Music and SFX itself and used to be the only thing that did. That works
; on a desktop, where the engine mixes buses in its own audio thread and a bus added at runtime is
; a bus like any other. It does not work in a browser: Godot's web export plays an AudioStreamWAV
; as a WebAudio buffer routed through a JavaScript-side copy of the bus graph, and that copy is
; built once, from this layout, before the first autoload runs. A bus created after that point
; exists only to the AudioServer, and every sound sent to it is silent.
;
; Both named buses therefore have to exist here, spelled exactly as AudioManager.SFX_BUS and
; AudioManager.MUSIC_BUS. tests/test_audio.gd checks that they do.
;
; Volumes stay at 0 dB. What the player set lives in the save file and is applied over the top by
; SaveManager.apply_settings, so a level baked in here would be a second opinion about the same
; number.
[gd_resource type="AudioBusLayout" format=3]

[resource]
bus/1/name = "Music"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = 0.0
bus/1/send = &"Master"
bus/2/name = "SFX"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = 0.0
bus/2/send = &"Master"

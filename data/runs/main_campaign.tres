[gd_resource type="Resource" script_class="RunDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/resources/run_definition.gd" id="1_run"]
[ext_resource type="Script" path="res://scripts/resources/floor_entry.gd" id="2_entry"]

[sub_resource type="Resource" id="Resource_floor_1"]
script = ExtResource("2_entry")
id = &"help_desk"
config_path = "res://data/floors/floor_1_help_desk.tres"

[sub_resource type="Resource" id="Resource_floor_2"]
script = ExtResource("2_entry")
id = &"development"
config_path = "res://data/floors/floor_2_development.tres"

[sub_resource type="Resource" id="Resource_floor_3"]
script = ExtResource("2_entry")
id = &"data_center"
config_path = "res://data/floors/floor_3_data_center.tres"

[sub_resource type="Resource" id="Resource_floor_4"]
script = ExtResource("2_entry")
id = &"cloud_ops"
config_path = "res://data/floors/floor_4_cloud_ops.tres"

[resource]
script = ExtResource("1_run")
id = &"main_campaign"
display_name = "RoboRush"
; Bumped to 2 when every floor's boss pool became all three bosses. A seed that used to hand floor
; 3 Cascade Failure now draws from three, so the same number no longer reproduces the same run —
; which is the whole contract this field carries. In-flight checkpoints are rejected on the
; mismatch rather than resumed into a run they no longer describe.
;
; And to 3 for Cloud Operations, which is a larger change to what a seed means than the last one: a
; run is four floors instead of three, so victory has moved, and every floor now draws its boss from
; four rather than three.
content_version = 3
floors = Array[FloorEntry]([SubResource("Resource_floor_1"), SubResource("Resource_floor_2"), SubResource("Resource_floor_3"), SubResource("Resource_floor_4")])
target_floor_count = 6
; Still false: four of six authored, and an incomplete campaign should play and report what is
; missing rather than refuse to start. Flipping this is the last act of the campaign, not an early one.
require_complete = false

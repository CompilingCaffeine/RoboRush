[gd_resource type="Resource" script_class="RunDefinition" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/resources/run_definition.gd" id="1_run"]
[ext_resource type="Script" path="res://scripts/resources/floor_entry.gd" id="2_entry"]


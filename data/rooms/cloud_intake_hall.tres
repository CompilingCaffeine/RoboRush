[resource]
script = ExtResource("1_template")
id = &"cloud_intake_hall"
type = 1
; The mechanic under mild pressure, which is the step between the start room and any
; room that asks something. One link, an open floor, and enough cover to make crossing
; a choice rather than the only option.
;
; Three spawn points and only the first forced, which is Floor 3's lesson applied
; before it can be repeated: that floor's teaching room forced *both* of its points and
; therefore drew nothing at all from the roster, so it contributed no variety on any
; seed and still took a fifth of the floor's combat rooms. Two of these three are
; ordinary weighted rolls.
obstacles = Array[Rect2i]([Rect2i(6, 3, 2, 2), Rect2i(18, 7, 2, 2)])
; The forced point comes first because `forced_enemies` pairs by index, and it is the one in
; the open middle of the room — the two rolls sit beside the cover blocks. So the guaranteed
; enemy is the one the player can always see, which is what a room teaching a movement idea
; wants standing in it.
enemy_spawns = Array[Vector2i]([Vector2i(13, 2), Vector2i(8, 9), Vector2i(18, 2)])
forced_enemies = Array[PackedScene]([ExtResource("2_forced")])
pad_links = Array[MigrationLink]([SubResource("Resource_link_0")])
reward_spawn = Vector2i(13, 9)
difficulty = 1
floor_tags = Array[StringName]([&"cloud_ops"])
min_floor = 4
max_floor = 4

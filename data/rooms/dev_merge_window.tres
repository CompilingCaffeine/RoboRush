[resource]
script = ExtResource("1_template")
id = &"dev_merge_window"
type = 1
obstacles = Array[Rect2i]([Rect2i(12, 2, 2, 3), Rect2i(5, 5, 2, 2), Rect2i(19, 5, 2, 2), Rect2i(12, 7, 2, 3)])
enemy_spawns = Array[Vector2i]([Vector2i(7, 2), Vector2i(18, 2), Vector2i(7, 9), Vector2i(18, 9)])

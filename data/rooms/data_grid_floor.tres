enemy_spawns = Array[Vector2i]([Vector2i(1, 6), Vector2i(13, 1), Vector2i(24, 6), Vector2i(13, 10), Vector2i(8, 6)])
; Mastery. Five zones in a checkerboard leave gaps rather than an aisle, so there is no standing
; position that is safe for a whole fight — only a sequence of them. A player who has understood
; the floor reads this room as a route; one who has not reads it as unfair, which is exactly the
; difference the last combat room of a floor should be able to tell.
;
; No cover at all, deliberately. Adding some would give the room a second answer and blunt the
; only question it asks.
thermal_zones = Array[Rect2i]([Rect2i(3, 2, 5, 3), Rect2i(11, 2, 5, 3), Rect2i(19, 2, 5, 3), Rect2i(7, 7, 5, 3), Rect2i(15, 7, 5, 3)])
reward_spawn = Vector2i(13, 6)
difficulty = 4

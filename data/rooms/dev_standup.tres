obstacles = Array[Rect2i]([Rect2i(11, 2, 1, 1), Rect2i(14, 2, 1, 1), Rect2i(9, 4, 1, 1), Rect2i(16, 4, 1, 1), Rect2i(9, 7, 1, 1), Rect2i(16, 7, 1, 1), Rect2i(11, 9, 1, 1), Rect2i(14, 9, 1, 1)])

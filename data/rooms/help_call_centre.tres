[ext_resource type="Script" path="res://scripts/resources/room_template.gd" id="1_template"]

[resource]
script = ExtResource("1_template")
id = &"help_call_centre"
type = 1
obstacles = Array[Rect2i]([Rect2i(3, 2, 4, 1), Rect2i(19, 2, 4, 1), Rect2i(3, 3, 1, 2), Rect2i(10, 3, 1, 6), Rect2i(15, 3, 1, 6), Rect2i(22, 3, 1, 2), Rect2i(3, 7, 1, 3), Rect2i(22, 7, 1, 3), Rect2i(4, 9, 3, 1), Rect2i(19, 9, 3, 1)])
enemy_spawns = Array[Vector2i]([Vector2i(4, 3), Vector2i(21, 3), Vector2i(4, 8), Vector2i(21, 8)])

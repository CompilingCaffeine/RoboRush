[gd_resource type="Resource" script_class="RoomTemplate" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/resources/room_template.gd" id="1_template"]
[ext_resource type="PackedScene" path="res://scenes/enemies/code_runner.tscn" id="2_code_runner"]
[ext_resource type="PackedScene" path="res://scenes/enemies/compiler.tscn" id="3_compiler"]
[ext_resource type="PackedScene" path="res://scenes/enemies/deadlock.tscn" id="4_deadlock"]

[resource]
script = ExtResource("1_template")
id = &"dev_server_ring"
type = 1
; Solid, and it was four separate walls forming a closed rectangle until `test_floor.gd` learned to
; flood-fill a template. The twenty-four tiles inside were sealed: floor the player could see, walk
; around, shoot across, and never once stand on — and `reward_spawn` was in the middle of them, so
; on every seed where this room paid out an item, the item dropped where nobody could reach it.
; `LootSpawner` only nudges a drop off ground that is *blocked*, and a walled courtyard is not
; blocked, it is unreachable, which is not the same thing and is why nothing caught it.
;
; Filled rather than opened, because filling is what the room already played like — nothing could
; enter the middle before either — and because the doc below is about a block thick enough to break
; a sight line from any direction, which a solid one is more of, not less.
obstacles = Array[Rect2i]([Rect2i(9, 3, 8, 6)])
enemy_spawns = Array[Vector2i]([Vector2i(3, 2), Vector2i(23, 2), Vector2i(3, 9), Vector2i(23, 9)])
; The Deadlock's signature room. Its tether is answered by putting something solid between
; the two of you, and the ring in the middle of this template is the only cover on the floor
; that is thick enough to break a sight line from any direction — so this is where the
; mechanic is legible on first contact rather than where it happens to land.
forced_enemies = Array[PackedScene]([ExtResource("2_code_runner"), ExtResource("3_compiler"), ExtResource("4_deadlock")])
reward_spawn = Vector2i(13, 10)
difficulty = 3
floor_tags = Array[StringName]([&"development"])
min_floor = 2
max_floor = 2

[resource]
script = ExtResource("1_template")
id = &"dev_code_freeze"
type = 1
obstacles = Array[Rect2i]([Rect2i(3, 2, 2, 2), Rect2i(6, 2, 2, 2), Rect2i(18, 2, 2, 2), Rect2i(21, 2, 2, 2), Rect2i(3, 5, 2, 2), Rect2i(6, 5, 2, 2), Rect2i(18, 5, 2, 2), Rect2i(21, 5, 2, 2), Rect2i(3, 8, 2, 2), Rect2i(6, 8, 2, 2), Rect2i(18, 8, 2, 2), Rect2i(21, 8, 2, 2)])

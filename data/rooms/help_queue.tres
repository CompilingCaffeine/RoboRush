[resource]
script = ExtResource("1_template")
id = &"help_queue"
type = 1
obstacles = Array[Rect2i]([Rect2i(4, 5, 1, 2), Rect2i(7, 5, 1, 2), Rect2i(10, 5, 1, 2), Rect2i(15, 5, 1, 2), Rect2i(18, 5, 1, 2), Rect2i(21, 5, 1, 2)])

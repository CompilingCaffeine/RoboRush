[gd_resource type="Resource" script_class="BossEncounter" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/resources/boss_encounter.gd" id="1_encounter"]
[ext_resource type="PackedScene" path="res://scenes/bosses/core_intelligence.tscn" id="2_scene"]

[resource]
script = ExtResource("1_encounter")
id = &"core_intelligence"
scene = ExtResource("2_scene")
display_name = "CORE INTELLIGENCE"
defeat_banner = "ROOT ACCESS GRANTED"
; One line per mask, in the order the campaign taught them. Five rather than three, because this
; boss's phases are the five fights it is quoting — see `CoreIntelligence`.
phase_banners = Array[String](["IT WEARS THE SCRAP KING", "IT WEARS RUNTIME ERROR", "IT WEARS CASCADE FAILURE", "IT WEARS THE ORCHESTRATOR", "IT WEARS NOTHING NOW"])

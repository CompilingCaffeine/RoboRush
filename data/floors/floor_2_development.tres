[resource]
script = ExtResource("1_floor")
id = &"development"
display_name = "Development"
floor_number = 2
theme = ExtResource("40_theme")
floor_tags = Array[StringName]([&"development"])
room_count = 10
start_templates = Array[RoomTemplate]([ExtResource("2_start")])
combat_templates = Array[RoomTemplate]([ExtResource("3_server_row"), ExtResource("4_cubicles"), ExtResource("5_cable_trench"), ExtResource("6_server_ring")])
treasure_templates = Array[RoomTemplate]([ExtResource("7_treasure")])
shop_templates = Array[RoomTemplate]([ExtResource("8_shop")])
boss_templates = Array[RoomTemplate]([ExtResource("9_boss_room")])
enemy_spawns = Array[EnemySpawn]([ExtResource("11_ticket_bot"), ExtResource("12_pop_up_drone"), ExtResource("26_code_runner"), ExtResource("27_compiler"), ExtResource("28_null_pointer"), ExtResource("29_recursion"), ExtResource("30_deadlock")])
clear_scrap_range = Vector2i(1, 3)
enemy_scrap_range = Vector2i(0, 2)
item_pool = ExtResource("91_pool")
item_clear_indices = Array[int]([2, 5])
shop = ExtResource("10_shop_cfg")
treasure_grants_item = true
; All three, matching floors 1 and 3. See floor 3's file for why Cascade Failure stopped being one
; floor's private boss; the short version is that a hazard which telegraphs for 1.6 seconds on
; ground nobody is standing on does not need nine rooms of setup, and a campaign whose third fight
; is fixed has one fewer decision in it than it should.
boss_pool = Array[BossEncounter]([ExtResource("92_king"), ExtResource("93_error"), ExtResource("94_cascade"), ExtResource("95_orchestrator")])

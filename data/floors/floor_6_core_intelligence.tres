[resource]
script = ExtResource("floor")
id = &"core_intelligence"
display_name = "Core Intelligence"
floor_number = 6
theme = ExtResource("theme")
floor_tags = Array[StringName]([&"core_intelligence"])
room_count = 10
start_templates = Array[RoomTemplate]([ExtResource("start")])
combat_templates = Array[RoomTemplate]([ExtResource("bootstrap"), ExtResource("prediction"), ExtResource("hot_path"), ExtResource("partition"), ExtResource("consensus"), ExtResource("recursion_gate"), ExtResource("last_instruction")])
treasure_templates = Array[RoomTemplate]([ExtResource("treasure")])
shop_templates = Array[RoomTemplate]([ExtResource("shop_room")])
boss_templates = Array[RoomTemplate]([ExtResource("boss_room")])
enemy_spawns = Array[EnemySpawn]([ExtResource("ticket"), ExtResource("runner"), ExtResource("compiler"), ExtResource("firewall"), ExtResource("leech"), ExtResource("null"), ExtResource("drone"), ExtResource("deadlock"), ExtResource("recursion")])
; Finale density rises, but its sixth shop should still ask the player to choose.
clear_scrap_range = Vector2i(1, 2)
enemy_scrap_range = Vector2i(0, 2)
item_pool = ExtResource("pool")
item_clear_indices = Array[int]([2, 5])
shop = ExtResource("shop")
treasure_grants_item = true
; The run ends with one authored encounter. Earlier boss pools cannot consume it.
boss_pool = Array[BossEncounter]([ExtResource("boss")])

[ext_resource type="Resource" path="res://data/rooms/combat_pillars.tres" id="4_pillars"]
[ext_resource type="Resource" path="res://data/rooms/combat_lanes.tres" id="5_lanes"]
[ext_resource type="Resource" path="res://data/rooms/combat_ring.tres" id="6_ring"]
[ext_resource type="Resource" path="res://data/rooms/treasure_vault.tres" id="7_treasure"]
[ext_resource type="Resource" path="res://data/rooms/shop_bay.tres" id="21_shop"]
[ext_resource type="Resource" path="res://data/rooms/boss_arena.tres" id="22_boss"]
[ext_resource type="Resource" path="res://data/settings/shop_config.tres" id="23_shop_cfg"]
[ext_resource type="Resource" path="res://data/spawns/ticket_bot.tres" id="8_ticket_bot"]
[ext_resource type="Resource" path="res://data/spawns/pop_up_drone.tres" id="8_pop_up_drone"]
[ext_resource type="Resource" path="res://data/spawns/memory_leech.tres" id="8_memory_leech"]
[ext_resource type="Resource" path="res://data/spawns/firewall_node.tres" id="8_firewall_node"]
[ext_resource type="Resource" path="res://data/floors/help_desk_theme.tres" id="26_theme"]
[ext_resource type="Resource" path="res://data/pools/run_item_pool.tres" id="90_pool"]
[ext_resource type="Resource" path="res://data/bosses/scrap_king_encounter.tres" id="92_king"]
[ext_resource type="Resource" path="res://data/bosses/runtime_error_encounter.tres" id="93_error"]
[ext_resource type="Resource" path="res://data/bosses/cascade_failure_encounter.tres" id="94_cascade"]
[ext_resource type="Resource" path="res://data/bosses/orchestrator_encounter.tres" id="95_orchestrator"]

[resource]
script = ExtResource("1_floor")
id = &"help_desk"
display_name = "Help Desk"
floor_number = 1
theme = ExtResource("26_theme")
floor_tags = Array[StringName]([&"help_desk"])
room_count = 10
start_templates = Array[RoomTemplate]([ExtResource("2_start")])
combat_templates = Array[RoomTemplate]([ExtResource("3_open"), ExtResource("4_pillars"), ExtResource("5_lanes"), ExtResource("6_ring")])
treasure_templates = Array[RoomTemplate]([ExtResource("7_treasure")])
shop_templates = Array[RoomTemplate]([ExtResource("21_shop")])
boss_templates = Array[RoomTemplate]([ExtResource("22_boss")])
enemy_spawns = Array[EnemySpawn]([ExtResource("8_ticket_bot"), ExtResource("8_pop_up_drone"), ExtResource("8_memory_leech"), ExtResource("8_firewall_node")])
clear_scrap_range = Vector2i(1, 3)
enemy_scrap_range = Vector2i(0, 2)
item_pool = ExtResource("90_pool")
item_clear_indices = Array[int]([2, 5])
shop = ExtResource("23_shop_cfg")
treasure_grants_item = true
; Every boss in the game, so the first floor's fight is a draw rather than a fixture. Cascade
; Failure is here on the argument in floor 3's file: its hazards telegraph for 1.6 seconds on empty
; ground, which is a thing a player can read the first time they see it, and the alternative was a
; campaign whose last fight never changed. This arena has no zones of its own, so the boss's vents
; are the only heated ground in the room — the cleanest possible first reading of the ramp.
boss_pool = Array[BossEncounter]([ExtResource("92_king"), ExtResource("93_error"), ExtResource("94_cascade"), ExtResource("95_orchestrator")])

[gd_scene load_steps=7 format=3]

; The Compiler's rung above. Same components, same shared `compiler.tres` — the second pass is
; written in that resource as what changes, the way the Recursion family's elder rung is — and its
; own sprite, because this is the one thing about the tier that has to be readable before it fires:
; a cross through the chassis, which is the attack.
;
; Untinted, unlike the Compiler it extends. That scene borrows the Firewall Node's silhouette and
; tints it cyan to tell the two apart; this one has a silhouette of its own and the cross in it is
; already the Compiler's colour.

[ext_resource type="Script" path="res://scenes/enemies/optimizing_compiler.gd" id="1_script"]
[ext_resource type="Resource" path="res://data/enemies/compiler.tres" id="2_config"]
[ext_resource type="Texture2D" path="res://art/enemies/optimizing_compiler.png" id="3_tex"]
[ext_resource type="Script" path="res://scripts/components/health_component.gd" id="4_health"]
[ext_resource type="Script" path="res://scripts/components/hurt_flash.gd" id="5_flash"]
[ext_resource type="Script" path="res://scripts/components/status_effect_controller.gd" id="99_status"]

[sub_resource type="CircleShape2D" id="CircleShape2D_body"]
radius = 7.0

[node name="OptimizingCompiler" type="CharacterBody2D" groups=["enemy"]]
collision_layer = 4
collision_mask = 1
motion_mode = 1
script = ExtResource("1_script")
config = ExtResource("2_config")

[node name="Shape" type="CollisionShape2D" parent="."]
shape = SubResource("CircleShape2D_body")

[node name="Sprite" type="Sprite2D" parent="."]
unique_name_in_owner = true

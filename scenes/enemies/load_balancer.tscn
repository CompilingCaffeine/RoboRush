[gd_scene load_steps=7 format=3]

; The Load Balancer. Nothing here is unusual for an enemy — the plate is not a node, because it is
; an arc the script draws under the sprite (see `LoadBalancer._draw`), and a node would have to be
; kept in step with the angle that already decides whether a hit lands.

[ext_resource type="Script" path="res://scenes/enemies/load_balancer.gd" id="1_script"]
[ext_resource type="Resource" path="res://data/enemies/load_balancer.tres" id="2_config"]
[ext_resource type="Texture2D" path="res://art/enemies/load_balancer.png" id="3_tex"]
[ext_resource type="Script" path="res://scripts/components/health_component.gd" id="4_health"]
[ext_resource type="Script" path="res://scripts/components/hurt_flash.gd" id="5_flash"]
[ext_resource type="Script" path="res://scripts/components/status_effect_controller.gd" id="99_status"]


[gd_scene load_steps=6 format=3]

; The Firewall Node's rung above. Same components, same shared `firewall_node.tres` — the failover
; is written in that resource as what changes, the way the Recursion family's elder rung is — and
; its own sprite, with a standby module above the core: the second unit, which is the whole reason
; the fan can grow.

[ext_resource type="Script" path="res://scenes/enemies/redundant_firewall.gd" id="1_script"]
[ext_resource type="Resource" path="res://data/enemies/firewall_node.tres" id="2_config"]
[ext_resource type="Texture2D" path="res://art/enemies/redundant_firewall.png" id="3_tex"]
[ext_resource type="Script" path="res://scripts/components/health_component.gd" id="4_health"]
[ext_resource type="Script" path="res://scripts/components/hurt_flash.gd" id="5_flash"]
[ext_resource type="Script" path="res://scripts/components/status_effect_controller.gd" id="99_status"]


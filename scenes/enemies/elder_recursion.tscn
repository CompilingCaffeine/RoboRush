[gd_scene load_steps=7 format=3]

; The elder rung of the Recursion family. Same components, same shared `recursion.tres`, and the
; same 7-pixel circle below — `ElderRecursion._become_elder` grows the sprite and that circle
; together at runtime from `RecursionConfig.elder_scale`, so the body the player shoots at is the
; size it looks and neither number can be changed without the other.
;
; A second scene rather than a flag on the first, because the floor's roster spawns a `PackedScene`
; and "which enemy may appear here" is the one question an `EnemySpawn` answers. What it is not is
; a second *enemy*: the script is a subclass, the config is the same resource, and the children it
; makes are `recursion.tscn` itself.

[ext_resource type="Script" path="res://scenes/enemies/elder_recursion.gd" id="1_script"]
[ext_resource type="Resource" path="res://data/enemies/recursion.tres" id="2_config"]
[ext_resource type="Texture2D" path="res://art/enemies/elder_recursion.png" id="3_tex"]
[ext_resource type="Script" path="res://scripts/components/health_component.gd" id="4_health"]
[ext_resource type="Script" path="res://scripts/components/hurt_flash.gd" id="5_flash"]
[ext_resource type="Script" path="res://scripts/components/status_effect_controller.gd" id="99_status"]

[sub_resource type="CircleShape2D" id="CircleShape2D_body"]
radius = 7.0

[node name="ElderRecursion" type="CharacterBody2D" groups=["enemy"]]
collision_layer = 4
collision_mask = 1
motion_mode = 1
script = ExtResource("1_script")
config = ExtResource("2_config")

[node name="Shape" type="CollisionShape2D" parent="."]
shape = SubResource("CircleShape2D_body")

[node name="Sprite" type="Sprite2D" parent="."]
unique_name_in_owner = true
texture = ExtResource("3_tex")

[node name="Health" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("4_health")
invulnerability_seconds = 0.0

[node name="HurtFlash" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("5_flash")
target_path = NodePath("../Sprite")

[node name="Status" type="Node2D" parent="."]
unique_name_in_owner = true
script = ExtResource("99_status")
indicator_radius = 15.0
